config APP_HEARTBEAT_PERIOD_MS
    int "Heartbeat period [ms]"
    default 500
    range 100 2000

menuconfig LED_SUBSYSTEM
    bool "LED Subsystem"
    default y

if LED_SUBSYSTEM

    choice 
        prompt "Led blink sleep time"
        default BLINK_SLEEP_TIME_1000MS

    config BLINK_SLEEP_TIME_250MS
        bool "250ms (very fast)"

    config BLINK_SLEEP_TIME_500MS
        bool "500ms (fast)"

    config BLINK_SLEEP_TIME_1000MS
        bool "1s (medium)"

    config BLINK_SLEEP_TIME_2000MS
        bool "2s (slow)"
        
    endchoice

    menuconfig LED_ADVANCED
        bool "Advanced LED setting"

    if LED_ADVANCED

        config LED_BRIGHTNESS
            int "LED brightness (0-100)"
            range 0 100
            default 100

        config LED_FADE_MS
            int "LED fade duration (ms)"
            range 0 5000
            default 500

        menu "Expert settings"
            visible if LED_ADVANCED

            config LED_DEBUG
                bool "Enable LED debugging"

            config BLINK_PATTERN
                bool "Custom blink pattern"
            
        endmenu

    endif # LED_ADVANCED

endif # LED_SUBSYSTEM

source "Kconfig.zephyr"
rsource "drivers/custom_sensor_led/Kconfig"
